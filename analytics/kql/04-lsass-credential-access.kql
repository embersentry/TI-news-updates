// ============================================================================
// A4 - OS Credential Dumping against LSASS
// ATT&CK: T1003.001 (LSASS Memory), T1003.003 (NTDS), T1003.002 (SAM),
//         T1555 (Credentials from Password Stores)
// Tables: DeviceProcessEvents, DeviceFileEvents  (plus optional DeviceEvents)
// Why:    Credential access is the hinge of almost every hands-on-keyboard
//         intrusion Red Canary reports, and LSASS is still the first stop.
//         This analytic covers the three observable surfaces that exist in
//         standard tables: the command line, the dump file hitting disk, and
//         the process-access API call.
// ============================================================================
let lookback = 14d;
// -- Branch 1: dumping commands, including the LOLBin variants ---------------
let CmdLineIndicators =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | extend cmd = tolower(ProcessCommandLine)
    | where
        // comsvcs.dll MiniDump - the most common no-tools-needed method
        (cmd has "comsvcs" and cmd has_any ("minidump", "#24", "#+24"))
        // procdump / sysinternals against lsass
        or (cmd has "lsass" and cmd has_any ("-ma", "/ma", "-accepteula", "fulldump", "-r "))
        // taskmgr-style and .NET dumping utilities
        or (cmd has "lsass" and FileName in~ ("procdump.exe", "procdump64.exe",
              "dumpert.exe", "createdump.exe", "dotnet-dump.exe", "werfault.exe",
              "sqldumper.exe", "tttracer.exe", "rdrleakdiag.exe", "avdump.exe"))
        // esentutl / nanodump / direct handle tools
        or cmd has_any ("nanodump", "mimikatz", "sekurlsa", "lsadump",
              "invoke-mimikatz", "dumpcreds", "safetykatz", "sharpdump",
              "privilege::debug", "token::elevate", "logonpasswords")
        // registry hive theft (SAM/SECURITY/SYSTEM) - T1003.002
        or (cmd has_any ("reg save", "reg.exe save", "esentutl") and cmd has_any ("hklm\\sam", "hklm\\security", "hklm\\system", "\\config\\sam"))
        // NTDS.dit via ntdsutil / vssadmin shadow copy - T1003.003
        or (cmd has_any ("ntdsutil", "ntds.dit") and cmd has_any ("ifm", "create full", "copy"))
        or (cmd has "vssadmin" and cmd has "create shadow" and cmd has_any ("/for=c", "for=c"))
        // browser / DPAPI credential stores - T1555
        or cmd has_any ("sharpdpapi", "lazagne", "\\login data", "logins.json", "vaultcmd /list")
    | extend DetectionBranch = "CommandLine"
    | project Timestamp, DetectionBranch, DeviceId, DeviceName, AccountDomain,
              AccountName, FileName, ProcessCommandLine, FolderPath, SHA256,
              InitiatingProcessFileName, InitiatingProcessCommandLine,
              ProcessId, InitiatingProcessId, ReportId, Evidence = ProcessCommandLine;
// -- Branch 2: memory dump artefacts written to disk ------------------------
let DumpFilesOnDisk =
    DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where ActionType in ("FileCreated", "FileRenamed", "FileModified")
    | extend fn = tolower(FileName), fp = tolower(FolderPath)
    | extend userWritable = fp has_any ("\\temp\\", "\\appdata\\", "\\programdata\\",
          "\\users\\public\\", "\\windows\\tasks\\", "\\perflogs\\", "\\downloads\\")
    | extend isMemoryDump = (fn endswith ".dmp" or fn endswith ".dump" or fn endswith ".bin")
          and (fn has_any ("lsass", "lsa", "sam", "creds", "dump", "proc", "memory") or userWritable)
    | extend isHiveOrDit = fn in~ ("ntds.dit", "sam", "security", "system") and userWritable
    | where isMemoryDump or isHiveOrDit
    // Exclude the OS's own crash-dump machinery by writer, not by path.
    | where InitiatingProcessFileName !in~ ("werfault.exe", "wermgr.exe",
          "svchost.exe", "msmpeng.exe", "mssense.exe", "sensendr.exe")
    | extend DetectionBranch = "DumpFileOnDisk"
    | project Timestamp, DetectionBranch, DeviceId, DeviceName,
              DumpFileName = FileName,
              AccountDomain = InitiatingProcessAccountDomain,
              AccountName = InitiatingProcessAccountName,
              FileName = InitiatingProcessFileName,
              ProcessCommandLine = InitiatingProcessCommandLine,
              FolderPath, SHA256,
              InitiatingProcessFileName = InitiatingProcessParentFileName,
              InitiatingProcessCommandLine = "",
              ProcessId = InitiatingProcessId,
              InitiatingProcessId = InitiatingProcessParentId,
              ReportId, Evidence = strcat(FolderPath, " <- ", InitiatingProcessFileName);
union isfuzzy=true CmdLineIndicators, DumpFilesOnDisk
| extend Severity = case(
      Evidence has_any ("comsvcs", "mimikatz", "sekurlsa", "nanodump", "ntds.dit", "hklm\\sam"), "High",
      DetectionBranch == "CommandLine", "High",
      "Medium")
| project Timestamp, Severity, DetectionBranch, DeviceName, AccountDomain,
          AccountName, FileName, ProcessCommandLine, FolderPath,
          DumpFileName, Evidence,
          SHA256, InitiatingProcessFileName, ProcessId, InitiatingProcessId,
          ReportId, DeviceId
| order by Timestamp desc
// --- Optional third branch (Defender XDR only) ------------------------------
// If DeviceEvents is onboarded, the highest-fidelity signal is a non-system
// process opening a handle to lsass.exe with dump rights:
//   DeviceEvents
//   | where Timestamp > ago(14d)
//   | where ActionType == "OpenProcessApiCall"
//   | where FileName =~ "lsass.exe"
//   | where InitiatingProcessFileName !in~ ("msmpeng.exe", "mssense.exe",
//           "sensendr.exe", "csfalconservice.exe", "svchost.exe", "wmiprvse.exe")
//   | project Timestamp, DeviceName, InitiatingProcessFileName,
//             InitiatingProcessCommandLine, InitiatingProcessAccountName
// --- Tuning -----------------------------------------------------------------
// Backup agents, EDR self-tests, AV vendors and crash handlers are the normal
// benign sources. Allow-list by (InitiatingProcessFileName + FolderPath +
// signer), and keep procdump exclusions scoped to your support team's jump box.
