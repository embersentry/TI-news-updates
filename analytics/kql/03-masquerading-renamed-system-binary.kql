// ============================================================================
// A3 - Masquerading: renamed or relocated system binaries
// ATT&CK: T1036.003 (Rename System Utilities), T1036.005 (Match Legitimate
//         Name or Location), T1218 (proxy execution follow-on)
// Tables: DeviceProcessEvents
// Why:    Masquerading is a perennial top-5 technique for Red Canary. It is
//         also one of the highest-fidelity things you can hunt, because
//         Defender records the PE metadata (ProcessVersionInfo*) separately
//         from the on-disk name. A mismatch between the two is close to
//         binary: either an attacker renamed the tool, or a vendor repacked it.
// ============================================================================
let lookback = 14d;
// Native tools attackers habitually copy and rename.
let watchedOriginalNames = dynamic([
      "powershell.exe", "pwsh.dll", "cmd.exe", "wscript.exe", "cscript.exe",
      "rundll32.exe", "regsvr32.exe", "mshta.exe", "certutil.exe",
      "bitsadmin.exe", "wmic.exe", "psexec.exe", "psexesvc.exe",
      "net.exe", "net1.exe", "nltest.exe", "whoami.exe", "systeminfo.exe",
      "reg.exe", "schtasks.exe", "sc.exe", "tasklist.exe", "taskkill.exe",
      "ntdsutil.exe", "vssadmin.exe", "wbadmin.exe", "bcdedit.exe",
      "procdump.exe", "procdump64.exe", "adexplorer.exe", "adfind.exe",
      "curl.exe", "ssh.exe", "plink.exe", "psftp.exe", "winscp.exe",
      "7z.exe", "rar.exe", "msiexec.exe", "installutil.exe",
      "mavinject.exe", "esentutl.exe", "makecab.exe", "expand.exe"]);
let systemDirs = dynamic(["c:\\windows\\system32\\", "c:\\windows\\syswow64\\",
      "c:\\windows\\winsxs\\", "c:\\windows\\servicing\\",
      "c:\\program files\\powershell\\", "c:\\windows\\system32\\windowspowershell\\",
      "c:\\windows\\syswow64\\windowspowershell\\"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where isnotempty(ProcessVersionInfoOriginalFileName)
| extend onDisk   = tolower(FileName)
| extend original = tolower(ProcessVersionInfoOriginalFileName)
| extend path     = tolower(FolderPath)
| extend company  = tolower(ProcessVersionInfoCompanyName)
| where original in (watchedOriginalNames)
| extend NameMismatch = onDisk != original
      // powershell.exe ships with an original name of "PowerShell.EXE"; pwsh
      // ships as pwsh.dll. Normalise those two known-good pairs.
      and not(onDisk == "pwsh.exe" and original == "pwsh.dll")
| extend OutsideSystemDir = not(path startswith_cs "c:\\windows\\system32\\")
      and not(path has_any (systemDirs))
      and company has_any ("microsoft", "sysinternals")
| where NameMismatch or OutsideSystemDir
| extend Technique = case(
      NameMismatch and OutsideSystemDir, "T1036.003 + T1036.005",
      NameMismatch, "T1036.003 Rename System Utilities",
      "T1036.005 Match Legitimate Name or Location")
| extend Severity = case(
      NameMismatch and path has_any ("\\appdata\\", "\\temp\\", "\\users\\public\\",
            "\\programdata\\", "\\downloads\\", "\\perflogs\\", "\\$recycle.bin\\"), "High",
      NameMismatch, "High",
      path has_any ("\\appdata\\", "\\temp\\", "\\users\\public\\", "\\programdata\\"), "Medium",
      "Low")
// Unsigned copies of Microsoft-branded tools are the strongest variant.
| extend SignatureConcern = iff(isempty(ProcessVersionInfoProductName), "NoProductName", "")
| project Timestamp, Severity, Technique,
          OnDiskName = FileName, OriginalName = ProcessVersionInfoOriginalFileName,
          FolderPath, SignatureConcern,
          ProcessVersionInfoCompanyName, ProcessVersionInfoProductName,
          DeviceName, AccountDomain, AccountName,
          ProcessCommandLine, SHA256,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          ProcessId, InitiatingProcessId, ReportId, DeviceId
| order by Severity asc, Timestamp desc
// --- Tuning -----------------------------------------------------------------
// Real-world benign causes: vendor-bundled curl/7z/ssh copies, Git for Windows,
// cloud agent payloads, and software that ships a renamed PsExec. Baseline by
// SHA256 + FolderPath, which survives a rename:
//   | where SHA256 !in (_GetWatchlist('ApprovedRepackagedTools') | project SearchKey)
