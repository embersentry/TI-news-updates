// ============================================================================
// A1 - Suspicious PowerShell Execution (encoded / downloaded / hidden)
// ATT&CK: T1059.001 (PowerShell), T1027 (Obfuscated Files or Information),
//         T1105 (Ingress Tool Transfer)
// Tables: DeviceProcessEvents  (Defender XDR advanced hunting / Sentinel via
//         the Microsoft Defender XDR data connector)
// Why:    Command and Scripting Interpreter is the single most prevalent
//         technique in Red Canary's Threat Detection Report, and PowerShell is
//         its dominant sub-technique. Nearly every commodity loader, RMM abuse
//         chain and ransomware precursor touches it.
// Model:  multi-signal scoring. One signal alone is noisy in any real estate;
//         two or more co-occurring signals is the detection.
// Note:   `has`/`has_any` match whole indexed TERMS, not substrings, so any
//         indicator that depends on punctuation ([char], ${, backtick, '+')
//         uses `contains` or `matches regex` instead. Do not "simplify" these
//         back to has_any - the signal silently stops matching.
// ============================================================================
let lookback = 7d;
// Interpreters, matched on the PE metadata too so renamed copies still hit.
let psImages = dynamic(["powershell.exe", "pwsh.exe", "powershell_ise.exe"]);
let psOriginalNames = dynamic(["powershell.exe", "pwsh.dll", "powershell_ise.exe"]);
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where FileName in~ (psImages)
    or tolower(ProcessVersionInfoOriginalFileName) in (psOriginalNames)
| extend cmd = tolower(ProcessCommandLine)
| extend Signals = set_difference(pack_array(
      // -enc / -ec / -e followed by a long base64 blob. Anchored on the blob
      // so that "-File e:\build.ps1" cannot match the bare term "e".
      iff(cmd matches regex @"\s[-/]e(c|nc|ncodedcommand)?\s+[a-z0-9+/=]{24,}"
          or cmd contains "frombase64string"
          or cmd contains "::frombase64", "EncodedOrBase64", ""),
      iff(cmd has_any ("downloadstring", "downloadfile", "downloaddata",
            "invoke-webrequest", "iwr", "invoke-restmethod", "start-bitstransfer",
            "net.webclient", "curl", "wget", "restmethod"), "RemoteDownload", ""),
      iff(cmd has_any ("hidden", "noprofile", "noninteractive", "bypass")
          or cmd matches regex @"\s-(w|nop|noni|ep|exec)\s", "StealthFlags", ""),
      iff(cmd has_any ("iex", "invoke-expression", "invoke-command")
          or cmd contains "&('"
          or cmd contains ".invoke("
          or cmd contains "scriptblock::create", "DynamicExecution", ""),
      // Obfuscation that is structural rather than lexical. These are all
      // punctuation-bearing, hence contains / regex.
      iff(cmd contains "[char]"
          or cmd contains "char[]"
          or cmd contains "${"
          or cmd contains "-bxor"
          or cmd matches regex @"`\w"
          or cmd matches regex @"'\s*\+\s*'"
          or cmd matches regex @"""\s*\+\s*""", "ObfuscationArtifacts", ""),
      iff(cmd has_any ("virtualalloc", "createremotethread", "memorystream",
            "deflatestream", "unsafe") or cmd contains "reflection.assembly"
          or cmd contains "marshal::", "InMemoryOrInjection", ""),
      iff(strlen(ProcessCommandLine) > 1200, "VeryLongCommandLine", "")
  ), dynamic([""]))
| extend SignalCount = array_length(Signals)
// Parents that have no business spawning PowerShell at all - treat as a
// severity amplifier rather than a filter.
| extend SuspiciousParent = InitiatingProcessFileName in~ (
      "winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "msaccess.exe",
      "visio.exe", "mshta.exe", "wscript.exe", "cscript.exe", "rundll32.exe",
      "regsvr32.exe", "msiexec.exe", "wmiprvse.exe", "w3wp.exe", "httpd.exe",
      "sqlservr.exe", "7zfm.exe", "winrar.exe", "acrord32.exe")
| where SignalCount >= 2 or (SignalCount >= 1 and SuspiciousParent)
| extend Severity = case(
      SignalCount >= 4, "High",
      SignalCount >= 2 and SuspiciousParent, "High",
      SignalCount == 3, "High",
      SignalCount == 2, "Medium",
      SignalCount == 1 and SuspiciousParent, "Medium",
      "Low")
| where Severity != "Low"
| project Timestamp, Severity, SignalCount, Signals, SuspiciousParent,
          DeviceName, AccountDomain, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine, InitiatingProcessAccountName,
          ProcessId, InitiatingProcessId, ReportId, DeviceId
| order by Timestamp desc
// --- Tuning -----------------------------------------------------------------
// Expect legitimate hits from SCCM/Intune, Chocolatey, backup agents and CI
// runners. Baseline first, then exclude on the *parent chain plus command
// shape*, never on the signal itself:
//   | where not(InitiatingProcessFileName =~ "ccmexec.exe" and cmd has "ccmsetup")
//   | where AccountName !in~ ("svc_sccm", "svc_backup")
// explorer.exe was deliberately removed from SuspiciousParent: a user running
// PowerShell from the shell is normal, and it dominated the parent signal.
