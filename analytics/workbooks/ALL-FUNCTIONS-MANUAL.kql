// WHAT IT IS : Contracted log sources, with criticality (watchlist TAM_ContractedSources)
_GetWatchlist('TAM_ContractedSources')
| project SourceName = tostring(column_ifexists("SourceName", "")),
          TableName = tostring(column_ifexists("TableName", "")),
          Match = tolower(tostring(column_ifexists("Match", ""))),
          Critical = tostring(column_ifexists("Critical", "")) in~ ("true", "yes", "y", "1"),
          Owner = tostring(column_ifexists("Owner", ""))

// ▲ END STEP 05 — copy everything above this blank line, then Save as function → name: TAM_ContractedSources



