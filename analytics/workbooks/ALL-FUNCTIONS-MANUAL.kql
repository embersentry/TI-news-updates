          Responded = isnotempty(RawScore),
          ActionedDate = todatetime(column_ifexists("ActionedDate", ""))

// ▲ END STEP 14 — copy everything above this blank line, then Save as function → name: TAM_CSAT



// === STEP 15 of 52 ==========================================================
// NAME       : TAM_Contract
// WHAT IT IS : Contract dates from CRM, one row (watchlist TAM_Contract)
_GetWatchlist('TAM_Contract')
| project ContractStart = todatetime(column_ifexists("ContractStart", "")),
          ContractEnd = todatetime(column_ifexists("ContractEnd", "")),
          RenewalConversationDate = todatetime(column_ifexists("RenewalConversationDate", ""))
| take 1

// ▲ END STEP 15 — copy everything above this blank line, then Save as function → name: TAM_Contract



