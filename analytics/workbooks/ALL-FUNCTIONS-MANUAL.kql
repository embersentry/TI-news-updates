// NAME       : TAM_Contacts
// WHAT IT IS : CRM relationship map (watchlist TAM_Contacts)
_GetWatchlist('TAM_Contacts')
| project Role = tostring(column_ifexists("Role", "")),
          Name = tostring(column_ifexists("Name", "")),
          StartDate = todatetime(column_ifexists("StartDate", "")),
