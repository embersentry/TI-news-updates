// WHAT IT IS : Enabled detections with ATT&CK mapping and source tables (watchlist TAM_DetectionInventory)
_GetWatchlist('TAM_DetectionInventory')
| project RuleName = tostring(column_ifexists("RuleName", "")),
          Platform = tostring(column_ifexists("Platform", "")),
          Enabled = tostring(column_ifexists("Enabled", "")) in~ ("true", "yes", "y", "1"),
          Techniques = toupper(tostring(column_ifexists("Techniques", ""))),
          Tables = tostring(column_ifexists("Tables", "")),
          DateAdded = todatetime(column_ifexists("DateAdded", ""))

// ▲ END STEP 06 — copy everything above this blank line, then Save as function → name: TAM_DetectionInventory



// === STEP 07 of 52 ==========================================================
// NAME       : TAM_ThreatProfile
// WHAT IT IS : Client threat profile: prioritised ATT&CK techniques (watchlist TAM_ThreatProfile)
_GetWatchlist('TAM_ThreatProfile')
| project TechniqueId = toupper(tostring(column_ifexists("TechniqueId", ""))),
          TechniqueName = tostring(column_ifexists("TechniqueName", "")),
          Priority = tostring(column_ifexists("Priority", ""))

// ▲ END STEP 07 — copy everything above this blank line, then Save as function → name: TAM_ThreatProfile



