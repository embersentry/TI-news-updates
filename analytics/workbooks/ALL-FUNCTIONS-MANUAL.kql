          RespondedTime = todatetime(column_ifexists("RespondedTime", "")),
          BlocksRemediation = tostring(column_ifexists("BlocksRemediation", "")) in~ ("true", "yes", "y", "1")

// ▲ END STEP 09 — copy everything above this blank line, then Save as function → name: TAM_ClientRequests



