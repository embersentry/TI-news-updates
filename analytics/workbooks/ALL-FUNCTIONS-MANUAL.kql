// ###########################################################################
// TAM EWI — ALL 52 SAVED FUNCTIONS, FOR MANUAL CREATION IN MICROSOFT SENTINEL
// ###########################################################################
//
// HOW TO USE (Azure portal → Log Analytics workspace → Logs, KQL mode)
//   1. Work top to bottom. Order matters: later functions call earlier ones.
//   2. Copy ONE block: from its '=== STEP' line down to the last line of code,
//      i.e. everything ABOVE the blank line and the '▲ END STEP' marker.
//      Do NOT copy the END marker: a comment as the last line can break a saved function.
//      Each block has no blank lines inside it, so the editor treats it as one query.
//   3. Paste into an EMPTY Logs editor → Save → Save as function.
//        Function name    : the NAME shown in the block (exact, case-sensitive)
//        Legacy category  : TAM EWI
//        Parameters       : only STEP 02 (TAM_WorkDays) has them — add exactly as shown
//   4. Clear the editor and repeat for the next block.
//   5. When all 52 are saved, test:  TAM_EWI() | project Family, IndicatorId, Display, State, Reason
//      Expect 24 rows. Indicators with no data source yet show State = 'No data'.
//
// Prerequisite: create watchlist TAM_EWIConfig first (watchlists/TAM_EWIConfig.csv).
//
// CHECKLIST (tick off as you save)
//   [ ] 01  TAM_ConfigBag
//   [ ] 02  TAM_WorkDays (s:datetime, e:datetime)
//   [ ] 03  TAM_History
//   [ ] 04  TAM_EstateInventory
//   [ ] 05  TAM_ContractedSources
//   [ ] 06  TAM_DetectionInventory
//   [ ] 07  TAM_ThreatProfile
//   [ ] 08  TAM_Tickets
//   [ ] 09  TAM_ClientRequests
//   [ ] 10  TAM_Runbooks
//   [ ] 11  TAM_Changes
//   [ ] 12  TAM_ServiceReviews
//   [ ] 13  TAM_Contacts
//   [ ] 14  TAM_CSAT
//   [ ] 15  TAM_Contract
//   [ ] 16  TAM_Entitlement
//   [ ] 17  TAM_PSA
//   [ ] 18  TAM_Signals
//   [ ] 19  TAM_VulnSnapshots
//   [ ] 20  TAM_Vulns
//   [ ] 21  TAM_D_Devices
//   [ ] 22  TAM_A01
//   [ ] 23  TAM_D_Sources
//   [ ] 24  TAM_A02
//   [ ] 25  TAM_D_Ingest
//   [ ] 26  TAM_A03
//   [ ] 27  TAM_A04
//   [ ] 28  TAM_D_Coverage
//   [ ] 29  TAM_A05
//   [ ] 30  TAM_A06
//   [ ] 31  TAM_A07
//   [ ] 32  TAM_D_Response
//   [ ] 33  TAM_A08
//   [ ] 34  TAM_A09
//   [ ] 35  TAM_A10
//   [ ] 36  TAM_D_Vulns
//   [ ] 37  TAM_A11
//   [ ] 38  TAM_B01
//   [ ] 39  TAM_B02
//   [ ] 40  TAM_B03
//   [ ] 41  TAM_B04
//   [ ] 42  TAM_B05
//   [ ] 43  TAM_B06
//   [ ] 44  TAM_B07
//   [ ] 45  TAM_B08
//   [ ] 46  TAM_B09
//   [ ] 47  TAM_B10
//   [ ] 48  TAM_G01
//   [ ] 49  TAM_EWI
//   [ ] 50  TAM_SnapshotPayload
//   [ ] 51  TAM_Trend
//   [ ] 52  TAM_D_Noise
// ###########################################################################



// === STEP 01 of 52 ==========================================================
// NAME       : TAM_ConfigBag
// WHAT IT IS : Per-account thresholds and settings as one dynamic bag (watchlist TAM_EWIConfig)
_GetWatchlist('TAM_EWIConfig')
| summarize Bag = make_bag(bag_pack(tostring(column_ifexists("Key", "")), tostring(column_ifexists("Value", ""))))

// ▲ END STEP 01 — copy everything above this blank line, then Save as function → name: TAM_ConfigBag



// === STEP 02 of 52 ==========================================================
// NAME       : TAM_WorkDays
// PARAMETERS : add in the Save-as-function dialog, in this order → name 's' type 'datetime', name 'e' type 'datetime'
// WHAT IT IS : Mon-Fri days elapsed between two datetimes (no holiday calendar)
let cum = dynamic([0, 0, 1, 2, 3, 4, 5, 5, 5, 6, 7, 8, 9, 10, 10]);
let n = toint((startofday(e) - startofday(s)) / 1d);
let dow = toint(dayofweek(s) / 1d);
let r = n % 7;
iff(n <= 0, 0, (n / 7) * 5 + toint(cum[dow + r + 1]) - toint(cum[dow + 1]))

// ▲ END STEP 02 — copy everything above this blank line, then Save as function → name: TAM_WorkDays



// === STEP 03 of 52 ==========================================================
// NAME       : TAM_History
// WHAT IT IS : Daily EWI snapshots (TAM_EWISnapshot_CL); empty until the snapshot job has run
union isfuzzy=true
    (TAM_EWISnapshot_CL
     | project TimeGenerated, IndicatorId, Indicator, Family, Value = todouble(Value), State),
    (datatable(TimeGenerated:datetime, IndicatorId:string, Indicator:string, Family:string, Value:real, State:string)[])

// ▲ END STEP 03 — copy everything above this blank line, then Save as function → name: TAM_History



// === STEP 04 of 52 ==========================================================
// NAME       : TAM_EstateInventory
// WHAT IT IS : Contracted asset list (watchlist TAM_EstateInventory)
_GetWatchlist('TAM_EstateInventory')
| project Hostname = tostring(column_ifexists("Hostname", "")),
          AssetType = tostring(column_ifexists("AssetType", "")),
          Owner = tostring(column_ifexists("Owner", "")),
          EdrInScope = tostring(column_ifexists("EdrInScope", "")) in~ ("true", "yes", "y", "1")

// ▲ END STEP 04 — copy everything above this blank line, then Save as function → name: TAM_EstateInventory



// === STEP 05 of 52 ==========================================================
